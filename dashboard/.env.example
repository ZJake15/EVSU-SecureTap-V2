# Base URL of the Django backend API. Usually leave this unset: the backend
# serves the dashboard itself (http://localhost:8000/), so the dashboard just
# calls /api on that same address, and `npm run dev` forwards /api to the
# backend (see vite.config.js). Only set it if the API lives somewhere else.
# VITE_API_BASE_URL=http://localhost:8000/api
