# Copy this file to .env and fill in real values. Never commit the real .env.

DJANGO_SECRET_KEY=generate-a-long-random-value-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Create this database + user first - see README.md for the SQL snippet.
DB_NAME=securetap
DB_USER=securetap_app
DB_PASSWORD=changeme
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret the entry-agent must send via the X-Service-Token header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENTRY_AGENT_SERVICE_TOKEN=generate-a-long-random-value-here

# face_recognition match distance threshold (lower = stricter). 0.45 is
# tightened from the library's 0.6 default for a security-gate use case.
FACE_MATCH_THRESHOLD=0.45

# The continuous camera scan re-checks the gate every couple of seconds -
# recognitions of the same person within this many seconds reuse the existing
# log row instead of creating a new one.
RECOGNITION_COOLDOWN_SECONDS=60

# An unrecognized face has no stable identity to dedupe by, so this limits how
# often a new photo of an unenrolled face gets captured/saved (gate-wide).
UNENROLLED_CAPTURE_COOLDOWN_SECONDS=30

TIME_ZONE=Asia/Manila
