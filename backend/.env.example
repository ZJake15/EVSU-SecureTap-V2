# Copy this file to .env and fill in real values. Never commit the real .env.

DJANGO_SECRET_KEY=generate-a-long-random-value-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Create this database + user first - see README.md for the SQL snippet.
DB_NAME=securetap
DB_USER=securetap_app
DB_PASSWORD=changeme
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret the entry-agent must send via the X-Service-Token header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENTRY_AGENT_SERVICE_TOKEN=generate-a-long-random-value-here

# ArcFace (InsightFace buffalo_l) cosine similarity threshold - HIGHER means
# stricter (opposite of a distance threshold). Run `manage.py
# evaluate_threshold` once real people are enrolled and use its
# recommendation instead of this starting-point value.
FACE_MATCH_SIMILARITY_THRESHOLD=0.45

# Passive liveness (anti-spoofing) score threshold - HIGHER means stricter,
# same sense as FACE_MATCH_SIMILARITY_THRESHOLD. Checks a standard 2D webcam
# frame for signs of a printed photo or screen replay (see
# users/liveness_utils.py) - not a validated value, tune against real
# spoof-attempt tests.
LIVENESS_SCORE_THRESHOLD=0.5

# The continuous camera scan re-checks the gate every couple of seconds -
# recognitions of the same person within this many seconds reuse the existing
# log row instead of creating a new one.
RECOGNITION_COOLDOWN_SECONDS=60

# An unrecognized face has no stable identity to dedupe by, so this limits how
# often a new photo of an unenrolled face gets captured/saved (gate-wide).
UNENROLLED_CAPTURE_COOLDOWN_SECONDS=30

# Same idea, but for spoof-suspected faces specifically - tracked separately
# so it can be tuned independently.
SPOOF_CAPTURE_COOLDOWN_SECONDS=30

# NFC tiebreak: how close a match has to be before the gate asks for a
# confirming card tap, and how long it waits for that tap.
TIEBREAK_MARGIN=0.05
TIEBREAK_TIMEOUT_SECONDS=10

# Rolling-window majority vote before a face match (or, as of the motion-blur
# fix, an "Unknown") is confirmed into a real log row.
VOTE_WINDOW_SIZE=4
VOTE_REQUIRED_AGREEMENT=2
VOTE_WINDOW_SECONDS=4

# Gate-scan-only settings (motion-blur / partial-face fix) - separate from
# enrollment's own quality checks, which stay fixed in insightface_utils.py.
# Smaller detector input = faster per-frame scan, at the cost of range on
# faces far from the camera - tune to your gate's typical distance.
GATE_SCAN_DET_SIZE=480
# Below this Laplacian variance, a gate-scan frame is treated as too blurry
# to trust and skipped (not logged as "no match") - more lenient than
# enrollment's fixed 80.0 since a walk-by frame is never studio-quality.
GATE_SCAN_MIN_BLUR_VARIANCE=25.0
# A face within this fraction of the frame edge is treated as partially cut
# off and skipped rather than matched.
FACE_EDGE_MARGIN_RATIO=0.02
# How far a face may be turned away from the camera before it's skipped
# rather than matched: the nose tip's offset from the midpoint between the
# eyes, over the inter-eye distance. 0.0 is dead-on frontal, ~0.35 is about a
# 30 degree turn. A turned face matches nobody (so an enrolled person gets
# logged Unknown) and can also fail the liveness check (logged as a spoof) -
# skipping waits for a frontal frame instead. Raise to accept more angles.
FACE_MAX_YAW_RATIO=0.35
# Below this, a face reads as possibly occluded (mouth/nose covered by a
# hand, mask, high collar) and is routed to its own occlusion_detected status
# instead of being matched or voted through as Unknown. A rough proxy, not a
# validated classifier - see the comment above this setting in settings.py
# before retuning it. On its own this misses a lot of partial coverage
# (mouth/chin only, not the nose) - see FACE_MAX_MOUTH_TEXTURE_RATIO below,
# a second signal that catches what this one misses.
FACE_MIN_MOUTH_VISIBILITY_RATIO=0.73
# Second occlusion signal: how texture-rich the lower face is relative to the
# upper face (forehead/eyes) - a real mouth has lips/teeth edges, a covering
# hand or cloth is comparatively smooth. Below this, occlusion is flagged
# even if FACE_MIN_MOUTH_VISIBILITY_RATIO didn't catch it. Same "starting
# point, not validated" caveat.
FACE_MAX_MOUTH_TEXTURE_RATIO=0.40
# Third occlusion signal: the detector's own per-face detection confidence
# (not a match score) - a covered face genuinely looks less face-like to the
# detector even when its regressed keypoints still land in a plausible
# arrangement. Below this, occlusion is flagged even if neither ratio above
# caught it. Same "starting point, not validated" caveat.
FACE_MIN_DET_SCORE_UNOCCLUDED=0.65
# Which rule decides "is this face covered": "rules" (the three thresholds
# above, any one tripping) or "classifier" (the model trained by
# `manage.py train_occlusion_classifier` from labeled photos, using the same
# three measurements). Classifier mode falls back to the rules by itself if
# the model file is missing, so it can't stop the gate scan. Either way, a
# face that already matches an enrolled person is never flagged as covered.
# The backend's dev server restarts itself when this file or the model file
# changes, so a change or a retrain takes effect within a few seconds.
OCCLUSION_DETECTION_MODE=rules
# Where the trained model is loaded from (defaults to
# backend/users/occlusion_classifier.joblib, which is where the training
# command saves it). Only needed if you keep it somewhere else.
# OCCLUSION_CLASSIFIER_PATH=
# Classifier mode only: its 0-1 "probably covered" cutoff. 0.5 matches what
# the training command's evaluation measured. Raise it for fewer false
# "please uncover your face" prompts, lower it to catch more real coverings.
OCCLUSION_CLASSIFIER_THRESHOLD=0.5
# Same "same situation still there" dedup as SPOOF_CAPTURE_COOLDOWN_SECONDS,
# for a confirmed occlusion_detected row - time-based only (not by embedding
# similarity), since an occluded frame's embedding is exactly what's
# unreliable here.
OCCLUSION_CAPTURE_COOLDOWN_SECONDS=30

TIME_ZONE=Asia/Manila
