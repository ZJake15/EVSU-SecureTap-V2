# Copy this file to .env and fill in real values. Never commit the real .env.

DJANGO_SECRET_KEY=generate-a-long-random-value-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Create this database + user first - see README.md for the SQL snippet.
DB_NAME=securetap
DB_USER=securetap_app
DB_PASSWORD=changeme
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret the entry-agent must send via the X-Service-Token header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENTRY_AGENT_SERVICE_TOKEN=generate-a-long-random-value-here

# ArcFace (InsightFace buffalo_l) cosine similarity threshold - HIGHER means
# stricter (opposite of a distance threshold). Run `manage.py
# evaluate_threshold` once real people are enrolled and use its
# recommendation instead of this starting-point value.
FACE_MATCH_SIMILARITY_THRESHOLD=0.45

# Passive liveness (anti-spoofing) score threshold - HIGHER means stricter,
# same sense as FACE_MATCH_SIMILARITY_THRESHOLD. Checks a standard 2D webcam
# frame for signs of a printed photo or screen replay (see
# users/liveness_utils.py) - not a validated value, tune against real
# spoof-attempt tests.
LIVENESS_SCORE_THRESHOLD=0.5

# The continuous camera scan re-checks the gate every couple of seconds -
# recognitions of the same person within this many seconds reuse the existing
# log row instead of creating a new one.
RECOGNITION_COOLDOWN_SECONDS=60

# An unrecognized face has no stable identity to dedupe by, so this limits how
# often a new photo of an unenrolled face gets captured/saved (gate-wide).
UNENROLLED_CAPTURE_COOLDOWN_SECONDS=30

# Same idea, but for spoof-suspected faces specifically - tracked separately
# so it can be tuned independently.
SPOOF_CAPTURE_COOLDOWN_SECONDS=30

# NFC tiebreak: how close a match has to be before the gate asks for a
# confirming card tap, and how long it waits for that tap.
TIEBREAK_MARGIN=0.05
TIEBREAK_TIMEOUT_SECONDS=10

# Rolling-window majority vote before a face match (or, as of the motion-blur
# fix, an "Unknown") is confirmed into a real log row.
VOTE_WINDOW_SIZE=4
VOTE_REQUIRED_AGREEMENT=2
VOTE_WINDOW_SECONDS=4

# Gate-scan-only settings (motion-blur / partial-face fix) - separate from
# enrollment's own quality checks, which stay fixed in insightface_utils.py.
# Smaller detector input = faster per-frame scan, at the cost of range on
# faces far from the camera - tune to your gate's typical distance.
GATE_SCAN_DET_SIZE=480
# Below this Laplacian variance, a gate-scan frame is treated as too blurry
# to trust and skipped (not logged as "no match") - more lenient than
# enrollment's fixed 80.0 since a walk-by frame is never studio-quality.
GATE_SCAN_MIN_BLUR_VARIANCE=25.0
# A face within this fraction of the frame edge is treated as partially cut
# off and skipped rather than matched.
FACE_EDGE_MARGIN_RATIO=0.02

TIME_ZONE=Asia/Manila
