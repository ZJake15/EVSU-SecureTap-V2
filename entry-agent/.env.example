# Copy this file to .env and fill in real values. Never commit the real .env.

API_BASE_URL=http://localhost:8000/api
GATE_LOCATION=Main Gate
# This installation's fixed direction - a reader at an entrance should stay
# "entry", one at an exit gate should stay "exit".
DIRECTION=entry

# Must match ENTRY_AGENT_SERVICE_TOKEN in the backend's .env.
SERVICE_TOKEN=FgHJ2nRKUOG9jHXZNiU9zWPTVLfH3skf9JNjclaSPho

CAMERA_INDEX=0

# Largest side (pixels) of each camera frame sent to the backend for face
# checks. 960 keeps faces several metres away recognizable; 640 is lighter
# and plenty when people stand close to the camera - use it on a low-power
# laptop (e.g. for a presentation).
# UPLOAD_MAX_DIMENSION=960
OFFLINE_DB_PATH=offline_queue.db
POLL_INTERVAL_SECONDS=0.5

# Optional/experimental, unset by default (normal auto-exposure). A shorter
# exposure time can reduce motion blur on someone walking through, but
# DirectShow's manual-exposure support varies a lot by webcam/driver - some
# ignore it entirely. See camera.py's _apply_exposure for units/how to check
# it actually took effect. Leave blank unless you've confirmed it works on
# your specific camera.
# CAMERA_EXPOSURE=-6

# Shown in the launcher's footer only - purely cosmetic, not an auth identity.
OFFICER_NAME=Guard on duty
APP_VERSION=v1.0

# USB vendor:product IDs the launcher's "is the card reader plugged in?"
# check accepts, comma-separated. Optional - the default covers a genuine
# ACS ACR122U (072F:2200) and the unbranded reader this gate uses
# (FFFF:0035). To find your reader's ID: Device Manager > the reader (under
# Keyboards or Human Interface Devices) > Properties > Details > Hardware Ids,
# and take the VID_xxxx and PID_xxxx values.
# NFC_READER_USB_IDS=072F:2200,FFFF:0035
